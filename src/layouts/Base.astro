</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!fine.matches || reduce.matches) return;

    const cursor = document.getElementById('site-cursor');
    if (!cursor) return;

    const INTERACTIVE =
      'a[href], button, [role="button"], [tabindex]:not([tabindex="-1"]), select, summary, label, input[type="submit"], input[type="checkbox"], input[type="radio"], input[type="range"]';
    const TEXTUAL =
      'input:not([type="submit"]):not([type="button"]):not([type="checkbox"]):not([type="radio"]):not([type="range"]), textarea, [contenteditable="true"]';

    let shown = false;

    document.addEventListener(
      'mousemove',
      (e) => {
        cursor.style.left = `${e.clientX}px`;
        cursor.style.top = `${e.clientY}px`;
        if (!shown) {
          cursor.classList.add('on');
          shown = true;
        }
      },
      { passive: true }
    );

    document.addEventListener('mouseleave', () => {
      if (shown) {
        cursor.classList.remove('on');
        shown = false;
      }
    });

    document.addEventListener('mouseover', (e) => {
      const target = e.target as HTMLElement | null;
      cursor.classList.toggle('is-link', !!target?.closest(INTERACTIVE));
      cursor.classList.toggle('is-text', !!target?.closest(TEXTUAL));
    });
  });
</script>

<style is:global>
  /* ============ site background ============ */
  .site-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bg-grid {
    position: absolute;
    inset: 0;
  }

  .bg-grid::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(91, 122, 157, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(91, 122, 157, 0.028) 1px, transparent 1px),
      linear-gradient(rgba(91, 122, 157, 0.013) 1px, transparent 1px),
      linear-gradient(90deg, rgba(91, 122, 157, 0.013) 1px, transparent 1px);
    background-size: 160px 160px, 160px 160px, 32px 32px, 32px 32px;
  }

  .bg-schematic {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    mask-image: radial-gradient(ellipse 115% 90% at 50% 42%, black 20%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 115% 90% at 50% 42%, black 20%, transparent 72%);
  }

  .bg-schematic svg {
    width: min(1400px, 120vw);
    height: auto;
    opacity: 0.22;
  }

  .s-frame {
    fill: none;
    stroke: rgba(91, 122, 157, 0.16);
    stroke-width: 1;
    stroke-dasharray: 6 8;
  }

  .s-tick {
    stroke: rgba(91, 122, 157, 0.22);
    stroke-width: 1;
  }

  .s-rack {
    fill: rgba(17, 22, 29, 0.22);
    stroke: rgba(91, 122, 157, 0.18);
    stroke-width: 1;
    stroke-dasharray: 4 5;
  }

  .s-node {
    fill: rgba(23, 29, 38, 0.4);
    stroke: rgba(131, 143, 161, 0.22);
    stroke-width: 1;
  }

  .s-spine,
  .s-link {
    fill: none;
    stroke: rgba(91, 122, 157, 0.2);
    stroke-width: 1;
  }

  .s-link {
    stroke-dasharray: 3 4;
  }

  .s-drop {
    fill: rgba(139, 155, 175, 0.3);
  }

  .s-drop-ok {
    fill: rgba(217, 154, 78, 0.5);
  }

  .s-drop-warn {
    fill: rgba(245, 185, 66, 0.5);
  }

  .s-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    fill: rgba(216, 222, 233, 0.28);
  }

  .s-cap {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    fill: rgba(131, 143, 161, 0.32);
  }

  .bg-radial {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(820px 620px at 78% 18%, rgba(217, 154, 78, 0.07), transparent 65%),
      radial-gradient(760px 560px at 14% 86%, rgba(91, 122, 157, 0.07), transparent 65%);
  }

  .bg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 30%, transparent 55%, rgba(11, 14, 20, 0.5) 100%);
  }

  .log-stream {
    position: absolute;
    inset: 0;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  .log-track {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    animation: scroll-logs 75s linear infinite;
  }

  .log-line {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-dim);
    /* single ambient layer, read at ~9%: visible up close, never loud */
    opacity: 0.09;
    white-space: nowrap;
    line-height: 1.6;
  }

  @keyframes scroll-logs {
    from { transform: translateY(0); }
    to   { transform: translateY(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .log-track {
      animation: none;
    }
  }

  .content {
    position: relative;
    z-index: 1;
  }

  /* ============ custom cursor ============ */
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    pointer-events: none;
    z-index: 9999;
    display: none;
    opacity: 0;
    transition: opacity 0.12s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .cursor {
      display: block;
    }
  }

  .cursor.on {
    opacity: 1;
  }

  /* never double up over native text caret */
  .cursor.is-text {
    opacity: 0;
  }

  .cursor::before,
  .cursor::after {
    content: '';
    position: absolute;
    background: rgba(131, 143, 161, 0.55);
    transition: opacity 0.1s ease;
  }

  .cursor::before {
    left: 6px;
    right: 6px;
    top: 50%;
    height: 1px;
    transform: translateY(-50%);
  }

  .cursor::after {
    top: 6px;
    bottom: 6px;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
  }

  .cur-brk {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -1px;
    line-height: 1;
    color: var(--accent-2);
    opacity: 0;
    transform: scale(0.75);
    transition: opacity 0.1s ease, transform 0.1s ease;
  }

  .cursor.is-link::before,
  .cursor.is-link::after {
    opacity: 0;
  }

  .cursor.is-link .cur-brk {
    opacity: 1;
    transform: scale(1);
  }
</style>