          <circle class="s-drop" cx="690" cy="140" r="2" />
          <circle class="s-drop" cx="690" cy="230" r="2" />
          <circle class="s-drop" cx="690" cy="320" r="2" />
          <circle class="s-drop" cx="690" cy="510" r="2" />
          <circle class="s-drop" cx="690" cy="600" r="2" />

          <!-- observability rack -->
          <rect class="s-rack" x="1150" y="180" width="300" height="240" rx="8" />
          <text class="s-cap" x="1180" y="168">observability</text>
          <rect class="s-node" x="1170" y="200" width="260" height="40" rx="5" />
