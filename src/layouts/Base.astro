          <rect class="s-node" x="1170" y="300" width="260" height="40" rx="5" />
          <circle class="s-drop-ok" cx="1188" cy="320" r="3" />
          <text class="s-lbl" x="1212" y="325">grafana</text>
          <path class="s-link" d="M810 230 H1090 V220 H1170" />
          <path class="s-link" d="M810 510 H1090 V320 H1170" />
        </svg>
      </div>
      <div class="bg-radial"></div>
      <div class="bg-vignette"></div>
      <div class="log-stream">
        <div class="log-track">
