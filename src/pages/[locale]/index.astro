---
// [locale]/index.astro: shared page template — content is locale-agnostic,
// all static copy is resolved via the translation dictionary at build time.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Profile from '../../components/Profile.astro';
import LabGrid from '../../components/LabGrid.astro';
import StackGrid from '../../components/StackGrid.astro';
import Comms from '../../components/Comms.astro';
import Footer from '../../components/Footer.astro';
import { langProps, locales } from '../../i18n/locale';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale, prefix, t } = langProps(Astro.params.locale);
const path = Astro.url.pathname;
---

<Base locale={locale} path={path}>
  <Nav t={t} locale={locale} prefix={prefix} path={path} />
  <Hero t={t} />
  <Profile t={t} />
  <LabGrid t={t} />
  <StackGrid t={t} />
  <Comms t={t} />
  <Footer t={t} />
</Base>
