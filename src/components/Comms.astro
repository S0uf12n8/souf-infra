---
// Comms.astro — contact/socials section
const links = [
  { label: 'GitHub', url: 'https://github.com/S0uf12n8', display: 'github.com/S0uf12n8' },
];
---

<section id="comms" class="comms-section">
  <h2 class="section-label">// COMMS — CONTACT</h2>
  <div class="terminal-window">
    <div class="terminal-chrome">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
      <span class="terminal-title">souf@infra:~</span>
    </div>
    <div class="terminal-body">
      <p class="comms-line"><span class="caret">></span> Reach out via:</p>
      {links.map((link) => (
        <p class="comms-line">
          <span class="comms-label">{link.label}</span>{' '}
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="comms-link">{link.display}</a>
        </p>
      ))}
    </div>
  </div>
</section>

<style>
  .comms-section {
    padding: 6rem 2rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .terminal-window {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .terminal-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.75rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red    { background: var(--danger); }
  .dot-yellow { background: var(--warn); }
  .dot-green  { background: var(--accent); }

  .terminal-title {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .terminal-body {
    padding: 1.25rem 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    line-height: 1.9;
  }

  .comms-line {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text);
  }

  .caret {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .comms-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-dim);
  }

  .comms-link {
    color: var(--accent-2);
  }

  .comms-link:hover {
    text-decoration: underline;
  }
</style>
