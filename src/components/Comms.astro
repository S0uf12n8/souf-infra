---
// Comms.astro — contact/socials section + Formspree contact form
const links = [
  { label: 'GitHub', url: 'https://github.com/S0uf12n8', display: 'github.com/S0uf12n8' },
  { label: 'LinkedIn', url: 'TODO_LINKEDIN_URL', display: 'TODO' },
];
---

<section id="comms" class="comms-section zone">
  <div class="wrap">
    <h2 class="section-label">// COMMS — CONTACT</h2>
    <div class="comms-grid">
    <div class="terminal-window">
      <div class="terminal-chrome">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
        <span class="terminal-title">souf@infra:~</span>
      </div>
      <div class="terminal-body">
        <p class="comms-line"><span class="caret">></span> Reach out via:</p>
        {links.map((link) => (
          <p class="comms-line">
            <span class="comms-label">{link.label}</span>{' '}
            {link.url.startsWith('TODO') ? (
              <span class="comms-todo">{link.display}</span>
            ) : (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="comms-link">{link.display}</a>
            )}
          </p>
        ))}
        <p class="comms-line"><span class="caret">></span> Or send a message:</p>
      </div>
    </div>

    <div class="terminal-window">
      <div class="terminal-chrome">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
        <span class="terminal-title">compose</span>
      </div>
      <div class="terminal-body">
        <form class="contact-form" action="TODO_FORMSPREE_URL" method="POST">
          <div class="form-row">
            <label class="form-label" for="comms-name">name_</label>
            <input class="form-input" type="text" id="comms-name" name="name" required autocomplete="name" placeholder="$ " />
          </div>
          <div class="form-row">
            <label class="form-label" for="comms-email">email_</label>
            <input class="form-input" type="email" id="comms-email" name="email" required autocomplete="email" placeholder="$ " />
          </div>
          <div class="form-row">
            <label class="form-label" for="comms-message">message_</label>
            <textarea class="form-input form-textarea" id="comms-message" name="message" rows="5" required placeholder="$ "></textarea>
          </div>
          <div class="form-actions">
            <button type="submit" class="form-submit">[ send ]</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  </div>
</section>

<style>
  .comms-section {
    padding-block: clamp(4.5rem, 10vh, 7rem);
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
  }

  .comms-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .terminal-window {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .terminal-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.75rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red    { background: var(--danger); }
  .dot-yellow { background: var(--warn); }
  .dot-green  { background: var(--accent); }

  .terminal-title {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .terminal-body {
    padding: 1.25rem 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    line-height: 1.9;
  }

  .comms-line {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text);
  }

  .caret {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .comms-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-dim);
  }

  .comms-link {
    color: var(--accent-2);
  }

  .comms-link:hover {
    text-decoration: underline;
  }

  .comms-todo {
    color: var(--text-dim);
    opacity: 0.5;
    font-style: italic;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .form-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .form-input {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--text);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    padding: 0.45rem 0;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    border-bottom-color: var(--accent);
  }

  .form-input::placeholder {
    color: var(--text-dim);
    opacity: 0.3;
  }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.55rem 0.75rem;
    background: var(--bg);
  }

  .form-textarea:focus {
    border-color: var(--accent);
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.25rem;
  }

  .form-submit {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 0.5rem 1.2rem;
    transition: background 0.2s, color 0.2s;
  }

  .form-submit:hover {
    background: var(--accent);
    color: var(--bg);
  }

  @media (max-width: 900px) {
    .comms-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
