---
// Profile.astro: vertical tab interface for About (whoami) / Experience / Education
import TimelineEntry from './TimelineEntry.astro';
import type { Dictionary } from '../i18n/translations/en';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;

const tabs = [
  { id: 'about', label: t.profile.tabs.about },
  { id: 'experience', label: t.profile.tabs.experience },
  { id: 'education', label: t.profile.tabs.education },
];
---

<section id="about" class="profile-section zone">
  <div class="wrap">
    <h2 class="section-label">{t.profile.label}</h2>
    <div class="terminal-window">
      <div class="terminal-chrome">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
        <span class="terminal-title">{t.profile.terminalTitle}</span>
      </div>
      <div class="profile-actions">
        <a class="profile-btn profile-btn-primary" href="/cv.pdf" title={t.profile.cvTitle}>[ {t.profile.downloadCV.slice(1, -1)} ]</a>
        <a
          class="profile-btn profile-btn-secondary"
          href="https://www.linkedin.com/in/soufiane-oulkadi/"
          target="_blank"
          rel="noopener noreferrer"
        >[ {t.profile.viewProfile.slice(1, -1)} ]</a>
      </div>
      <div class="profile-body">
        <div class="tab-rail" role="tablist" aria-label={t.profile.tabRailAria} aria-orientation="vertical">
          {tabs.map((tabItem, i) => (
            <button
              type="button"
              id={`ptab-${tabItem.id}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`ppanel-${tabItem.id}`}
              data-tab={tabItem.id}
              class:list={['tab-btn', { active: i === 0 }]}
            >
              <span class="tab-tick" aria-hidden="true">&gt;</span>
              {tabItem.label}
            </button>
          ))}
        </div>

        <div class="tab-panels">
          <div
            id="ppanel-about"
            role="tabpanel"
            aria-labelledby="ptab-about"
            data-panel="about"
            class="tab-panel"
          >
            <div class="whoami">
              <p class="status-line"><span class="caret">&gt;</span> <span class="status-label">{t.profile.whoami.systemStatus}</span> <span class="status-val status-active">{t.profile.whoami.active}</span></p>
              <p class="status-line"><span class="caret">&gt;</span> <span class="status-label">{t.profile.whoami.base}</span> <span class="status-val">{t.profile.whoami.baseVal}</span></p>
              <p class="status-line"><span class="caret">&gt;</span> <span class="status-label">{t.profile.whoami.background}</span> <span class="status-val">{t.profile.whoami.backgroundVal}</span></p>
              <p class="status-line"><span class="caret">&gt;</span> <span class="status-label">{t.profile.whoami.currentFocus}</span> <span class="status-val">{t.profile.whoami.currentFocusVal}</span></p>
              <p class="status-line"><span class="caret">&gt;</span> <span class="status-label">{t.profile.whoami.target}</span> <span class="status-val">{t.profile.whoami.targetVal}</span></p>
            </div>
            <div class="profile-aside">
              <p class="aside-kicker">{t.profile.contextKicker}</p>
              <p class="bio">{t.profile.bio}</p>
            </div>
          </div>

          <div
            id="ppanel-experience"
            role="tabpanel"
            aria-labelledby="ptab-experience"
            data-panel="experience"
            class="tab-panel"
            hidden
          >
            <div class="panel-path">
              <TimelineEntry
                tag={t.experience.dewebKicker}
                title={t.experience.dewebTitle}
                meta={t.experience.dewebMeta}
                image="/images/deweb.png"
                imageAlt="DEWEB Technology logo"
                subs={[
                  {
                    title: t.experience.dewebSub1Title,
                    kind: t.experience.fullTime,
                    period: t.experience.dewebSub1Period,
                    points: t.experience.dewebSub1Points,
                    skills: t.experience.dewebSub1Skills,
                  },
                  {
                    title: t.experience.dewebSub2Title,
                    kind: t.experience.intern,
                    period: t.experience.dewebSub2Period,
                    points: t.experience.dewebSub2Points,
                  },
                ]}
              />
              <TimelineEntry
                tag={t.experience.accessKicker}
                title={t.experience.accessTitle}
                meta={t.experience.accessMeta}
                image="/images/accesspoint.png"
                imageAlt="Access Point IT logo"
                subs={[
                  {
                    title: t.experience.accessSubTitle,
                    kind: t.experience.intern,
                    period: t.experience.accessPeriod,
                    points: t.experience.accessPoints,
                    skills: t.experience.accessSkills,
                  },
                ]}
                last
              />
            </div>
          </div>

          <div
            id="ppanel-education"
            role="tabpanel"
            aria-labelledby="ptab-education"
            data-panel="education"
            class="tab-panel"
            hidden
          >
            <div class="panel-path">
              <TimelineEntry
                tag={t.education.techKicker}
                title={t.education.techTitle}
                meta={t.education.techMeta}
                image="/images/ofppt.png"
                imageAlt="OFPPT logo"
              />
              <TimelineEntry
                tag={t.education.deugKicker}
                title={t.education.deugTitle}
                meta={t.education.deugMeta}
                note={t.education.deugNote}
                image="/images/ibn-zohr.png"
                imageAlt="Université Ibn Zohr logo"
              />
              <TimelineEntry
                tag={t.education.licenceKicker}
                title={t.education.licenceTitle}
                meta={t.education.licenceMeta}
                image="/images/ibn-zohr.png"
                imageAlt="Université Ibn Zohr logo"
                last
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('.tab-btn'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.tab-panel'));

    function activate(id: string) {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', String(on));
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== id;
      });
    }

    tabs.forEach((t) => {
      t.addEventListener('click', () => activate(t.dataset.tab ?? 'about'));
    });

    const rail = document.querySelector<HTMLElement>('.tab-rail');
    rail?.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      const idx = tabs.findIndex((t) => t === document.activeElement);
      if (idx === -1) return;
      const next = e.key === 'ArrowDown' ? (idx + 1) % tabs.length : (idx - 1 + tabs.length) % tabs.length;
      tabs[next].focus();
      activate(tabs[next].dataset.tab ?? 'about');
    });
  });
</script>

<style>
  .profile-section {
    padding-block: clamp(4.5rem, 10vh, 7rem);
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
  }

  .terminal-window {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .terminal-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.75rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red    { background: var(--danger); }
  .dot-yellow { background: var(--warn); }
  .dot-green  { background: var(--accent); }

  .terminal-title {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.85rem 1.75rem;
    border-bottom: 1px solid var(--border);
    background: rgba(23, 29, 38, 0.35);
  }

  .profile-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    padding: 0.5rem 1.05rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }

  .profile-btn-primary {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .profile-btn-primary:hover {
    background: var(--accent-hover);
  }

  .profile-btn-secondary {
    background: transparent;
    color: var(--accent-2);
    border-color: var(--accent-2);
  }

  .profile-btn-secondary:hover {
    background: var(--accent-2);
    color: var(--bg);
  }

  .profile-body {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
  }

  .tab-rail {
    border-right: 1px solid var(--border);
    background: rgba(23, 29, 38, 0.35);
    padding: 1rem 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    background: none;
    border: none;
    border-radius: 4px;
    padding: 0.55rem 0.7rem;
    text-align: left;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .tab-btn:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .tab-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .tab-btn.active {
    color: var(--accent);
    background: var(--surface-2);
  }

  .tab-tick {
    font-weight: 700;
    color: var(--accent);
    visibility: hidden;
    min-width: 0.6rem;
  }

  .tab-btn.active .tab-tick {
    visibility: visible;
  }

  .tab-panels {
    padding: 1.35rem 1.75rem;
    min-width: 0;
  }

  .whoami {
    font-family: 'JetBrains Mono', monospace;
  }

  .status-line {
    color: var(--text);
    line-height: 1.9;
  }

  .caret {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .status-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-dim);
  }

  .status-val {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text);
  }

  .status-active {
    color: var(--accent);
  }

  .profile-aside {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border);
  }

  .aside-kicker {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-2);
    margin-bottom: 0.9rem;
  }

  .bio {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-dim);
    max-width: 68ch;
  }

  .panel-path {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 900px) {
    .profile-body {
      grid-template-columns: 1fr;
    }

    .tab-rail {
      flex-direction: row;
      border-right: none;
      border-bottom: 1px solid var(--border);
      gap: 0.25rem;
      padding: 0.5rem;
    }

    .tab-btn {
      flex: 1;
    }
  }
</style>