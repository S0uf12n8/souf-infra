---
// Hero.astro — terminal boot sequence with typewriter effect
---

<section class="hero">
  <div class="terminal-window">
    <div class="terminal-chrome">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
      <span class="terminal-title">souf@infra:~</span>
    </div>
    <div class="terminal-body">
      <p class="line"><span class="prompt">$</span> ssh souf@infra</p>
      <p class="line dim">Connecting...</p>
      <p class="line dim">Authenticated as S0uf12n8</p>
      <p class="line"><span class="prompt">></span> whoami</p>
      <p class="line">Souf — CS student, ex-Systems & Network technician, building toward DevOps/DevSecOps.</p>
      <p class="line"><span class="prompt">></span> status</p>
      <p class="line">Final-year Licence GI · Faculty of Taroudant, Morocco</p>
    </div>
  </div>
  <div class="hero-actions">
    <a href="#lab" class="btn btn-primary">[ View Lab ]</a>
    <a href="#comms" class="btn btn-secondary">[ Contact ]</a>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lines = document.querySelectorAll<HTMLElement>('.hero .line');
    const actions = document.querySelector<HTMLElement>('.hero-actions');
    let delay = 400;

    lines.forEach((line) => {
      const len = line.textContent?.trim().length ?? 0;
      setTimeout(() => line.classList.add('visible'), delay);
      delay += len * 25 + 180;
    });

    setTimeout(() => actions?.classList.add('visible'), delay);
  });
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .terminal-window {
    width: 100%;
    max-width: 640px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .terminal-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.75rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red    { background: var(--danger); }
  .dot-yellow { background: var(--warn); }
  .dot-green  { background: var(--accent); }

  .terminal-title {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .terminal-body {
    padding: 1.25rem 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    line-height: 1.8;
  }

  .line {
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 400;
    opacity: 0;
    transition: opacity 0.15s ease-in;
  }

  .line.visible {
    opacity: 1;
  }

  .line.dim {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .prompt {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    opacity: 0;
    transition: opacity 0.4s ease-in;
  }

  .hero-actions.visible {
    opacity: 1;
  }

  .btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .btn-primary:hover {
    text-decoration: none;
    background: var(--accent-hover);
  }

  .btn-secondary {
    background: transparent;
    color: var(--accent-2);
    border-color: var(--accent-2);
  }

  .btn-secondary:hover {
    text-decoration: none;
    background: var(--accent-2);
    color: var(--bg);
  }
</style>
