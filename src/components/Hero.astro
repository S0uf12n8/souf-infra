          <span class="log-line">[2026-08-26T01:12:10Z] prometheus[1044]: TSDB started</span>
          <span class="log-line">[2026-08-26T01:12:11Z] nginx[756]: worker process 1247 started</span>
          <span class="log-line">[2026-08-26T01:12:12Z] systemd[1]: Starting Kubernetes API Server...</span>
          <span class="log-line">[2026-08-26T01:12:13Z] kube-apiserver[1201]: Serving securely on :6443</span>
          <span class="log-line">[2026-08-26T01:12:14Z] etcd[1187]: ready to serve client requests</span>
          <span class="log-line">[2026-08-26T01:12:15Z] github-actions-runner[892]: Listening for jobs</span>
          <span class="log-line">[2026-08-26T01:12:16Z] grafana[1304]: HTTP Server Listen on :3000</span>
          <span class="log-line">[2026-08-26T01:12:17Z] alertmanager[1356]: Listening on :9093</span>
