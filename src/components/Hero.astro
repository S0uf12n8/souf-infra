---
// Hero.astro: asymmetric split: terminal boot sequence + homelab topology (real nodes only)
import type { Dictionary } from '../i18n/translations/en';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;

const bootLines = t.hero.boot.map((line, i) => ({
  text: line,
  dim: t.hero.bootDim.includes(i),
  hasPrompt: t.hero.bootPrompt.includes(i),
  promptChar: t.hero.bootPrompt.includes(i) ? (i === 0 ? '$' : '>') : null,
}));
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-terminal">
      <div class="terminal-window">
        <div class="terminal-chrome">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
          <span class="terminal-title">{t.hero.terminalTitle}</span>
        </div>
        <div class="terminal-body">
          {bootLines.map((line) => (
            <p class:list={['line', { dim: line.dim }]}>
              {line.hasPrompt && <span class="prompt">{line.promptChar}</span>}
              {line.text.replace(/^[>$]\s?/, '')}
            </p>
          ))}
        </div>
      </div>
      <div class="hero-actions">
        <a href="#about" class="btn btn-primary">{t.hero.viewProfile}</a>
        <a href="#comms" class="btn btn-secondary">{t.hero.contact}</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="viz-panel">
        <div class="viz-head">{t.hero.vizHead}</div>
        <svg class="viz-svg" viewBox="0 0 560 252">
          <!-- lab-net spine -->
          <line class="v-spine" x1="280" y1="36" x2="280" y2="196" />
          <circle class="v-pulse" cx="280" cy="64" r="4" />
          <!-- taps -->
          <line class="v-tap" x1="180" y1="76" x2="280" y2="76" />
          <line class="v-tap" x1="180" y1="176" x2="280" y2="176" />
          <line class="v-tap" x1="280" y1="76" x2="380" y2="76" />
          <line class="v-tap" x1="280" y1="176" x2="380" y2="176" />
          <!-- node dots -->
          <circle class="v-drop" cx="280" cy="76" r="3" />
          <circle class="v-drop" cx="280" cy="176" r="3" />
          <!-- left column -->
          <rect class="v-rect" x="40" y="48" width="140" height="56" rx="6" />
          <circle class="v-dot-ok" cx="58" cy="76" r="4" />
          <text class="v-txt" x="110" y="79" text-anchor="middle">gateway</text>
          <rect class="v-rect" x="40" y="148" width="140" height="56" rx="6" />
          <circle class="v-dot-pending" cx="58" cy="176" r="4" />
          <text class="v-txt" x="110" y="179" text-anchor="middle">app-svc</text>
          <!-- right column -->
          <rect class="v-rect" x="380" y="48" width="140" height="56" rx="6" />
          <circle class="v-dot-ok" cx="398" cy="76" r="4" />
          <text class="v-txt" x="450" y="79" text-anchor="middle">worker-01</text>
          <rect class="v-rect" x="380" y="148" width="140" height="56" rx="6" />
          <circle class="v-dot-pending" cx="398" cy="176" r="4" />
          <text class="v-txt" x="450" y="179" text-anchor="middle">db-primary</text>
          <!-- bus annotation -->
          <text class="v-cap" x="280" y="26" text-anchor="middle">lab-net</text>
        </svg>
        <div class="viz-status">
          <span class="viz-line"><i class="viz-dot ok"></i> ssh-hardened&nbsp;&nbsp;&nbsp;ok</span>
          <span class="viz-line"><i class="viz-dot ok"></i> ufw · fail2ban&nbsp;&nbsp;active</span>
          <span class="viz-line"><i class="viz-dot pending"></i> docker-platform&nbsp;building</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lines = document.querySelectorAll<HTMLElement>('.hero .line');
    const actions = document.querySelector<HTMLElement>('.hero-actions');
    const prefersReduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

    if (prefersReduced) {
      lines.forEach((line) => line.classList.add('visible'));
      actions?.classList.add('visible');
      return;
    }

    let delay = 400;

    lines.forEach((line) => {
      const len = line.textContent?.trim().length ?? 0;
      setTimeout(() => line.classList.add('visible'), delay);
      delay += Math.min(len, 18) * 11 + 110;
    });

    setTimeout(() => actions?.classList.add('visible'), delay);
  });
</script>

<style>
  .hero {
    position: relative;
  }

  .hero-inner {
    width: 100%;
    max-width: 1520px;
    margin-inline: auto;
    padding: clamp(3.5rem, 7vh, 5rem) clamp(1.25rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .terminal-window {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .terminal-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.65rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red    { background: var(--danger); }
  .dot-yellow { background: var(--warn); }
  .dot-green  { background: var(--accent); }

  .terminal-title {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .terminal-body {
    padding: 1rem 1.25rem;
    font-family: 'JetBrains Mono', monospace;
    line-height: 1.75;
  }

  .line {
    color: var(--text);
    font-size: 0.83rem;
    font-weight: 400;
    opacity: 0;
    transition: opacity 0.15s ease-in;
  }

  .line.visible {
    opacity: 1;
  }

  .line.dim {
    font-size: 0.73rem;
    color: var(--text-dim);
  }

  .prompt {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    opacity: 0;
    transition: opacity 0.4s ease-in;
  }

  .hero-actions.visible {
    opacity: 1;
  }

  .btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .btn-primary:hover {
    text-decoration: none;
    background: var(--accent-hover);
  }

  .btn-secondary {
    background: transparent;
    color: var(--accent-2);
    border-color: var(--accent-2);
  }

  .btn-secondary:hover {
    text-decoration: none;
    background: var(--accent-2);
    color: var(--bg);
  }

  /* --- right-hand visual column --- */
  .hero-visual {
    position: relative;
  }

  /* ambient glow that peaks behind the panel (clipped so the 15% bleed can't
     stretch the document horizontally at tablet widths) */
  .hero-visual {
    overflow: clip;
  }

  .hero-visual::before {
    content: '';
    position: absolute;
    inset: -15%;
    background: radial-gradient(460px 340px at 55% 45%, rgba(217, 154, 78, 0.1), transparent 70%),
      radial-gradient(340px 280px at 80% 75%, rgba(91, 122, 157, 0.1), transparent 70%);
    pointer-events: none;
  }

  .viz-panel {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 10px;
    background:
      linear-gradient(180deg, rgba(23, 29, 38, 0.55), rgba(17, 22, 29, 0.8));
    padding: 1rem 1.25rem 1.1rem;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  /* local drafting grid inside the panel */
  .viz-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 10px;
    background-image:
      linear-gradient(rgba(91, 122, 157, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(91, 122, 157, 0.035) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at 50% 30%, black 20%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 30%, black 20%, transparent 78%);
    pointer-events: none;
  }

  .viz-head {
    position: relative;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-2);
    opacity: 0.85;
    margin-bottom: 0.6rem;
  }

  .viz-svg {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
  }

  .v-spine {
    stroke: rgba(91, 122, 157, 0.5);
    stroke-width: 1;
  }

  .v-tap {
    stroke: rgba(91, 122, 157, 0.35);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }

  .v-drop {
    fill: var(--accent-2);
    opacity: 0.7;
  }

  .v-rect {
    fill: rgba(23, 29, 38, 0.72);
    stroke: rgba(131, 143, 161, 0.38);
    stroke-width: 1;
  }

  .v-txt {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    fill: rgba(216, 222, 233, 0.6);
    letter-spacing: 0.02em;
  }

  .v-cap {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    fill: rgba(131, 143, 161, 0.5);
  }

  .v-dot-ok      { fill: var(--accent-2); }
  .v-dot-pending { fill: var(--warn); }

  .v-pulse {
    fill: var(--accent);
    opacity: 0;
    animation: pulse-spine 8s linear infinite;
  }

  @keyframes pulse-spine {
    0%   { opacity: 0; transform: translateY(0); }
    8%   { opacity: 0.9; }
    92%  { opacity: 0.9; transform: translateY(176px); }
    100% { opacity: 0; transform: translateY(176px); }
  }

  .viz-status {
    position: relative;
    margin-top: 0.75rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .viz-line {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .viz-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .viz-dot.ok {
    background: var(--accent-2);
    box-shadow: 0 0 6px rgba(91, 122, 157, 0.5);
    animation: viz-blink 3s ease-in-out infinite;
  }

  .viz-dot.pending {
    background: var(--warn);
    box-shadow: 0 0 6px rgba(245, 185, 66, 0.5);
    animation: viz-blink 1.6s ease-in-out infinite;
  }

  @keyframes viz-blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
  }

  @media (prefers-reduced-motion: reduce) {
    .v-pulse { animation: none; opacity: 0.8; }
    .viz-dot { animation: none; }
  }

  @media (max-width: 1020px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      max-width: 720px;
    }
  }

  @media (max-width: 560px) {
    .hero-visual {
      display: none;
    }
  }
</style>