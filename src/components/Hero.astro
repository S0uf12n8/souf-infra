          <span class="log-line">[2026-08-26T01:12:03Z] systemd[1]: Reached target Multi-User System</span>
          <span class="log-line">[2026-08-26T01:12:03Z] dockerd[842]: API listen on /var/run/docker.sock</span>
          <span class="log-line">[2026-08-26T01:12:04Z] kubelet[1102]: Started container runtime</span>
          <span class="log-line">[2026-08-26T01:12:05Z] sshd[671]: Accepted publickey for souf from 10.0.2.15</span>
          <span class="log-line">[2026-08-26T01:12:06Z] kernel: [UFW BLOCK] IN=eth0 SRC=185.224.128.0 DST=10.0.2.15</span>
          <span class="log-line">[2026-08-26T01:12:07Z] containerd[839]: containerd: healthy</span>
          <span class="log-line">[2026-08-26T01:12:08Z] cron[512]: (CRON) CMD (/usr/local/bin/backup.sh)</span>
          <span class="log-line">[2026-08-26T01:12:09Z] node_exporter[923]: Listening on :9100</span>
