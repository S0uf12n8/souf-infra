---
// SoundToggle.astro: opt-in UI click sounds. Muted by default — sound is only
// initialized after the user enables it (a required user gesture). Clicks are
// synthesized via Web Audio API (short noise burst with fast decay), so there
// is zero network weight for visitors who never opt in.
import type { Dictionary } from '../i18n/translations/en';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<button
  type="button"
  id="sound-toggle"
  class="snd-toggle"
  aria-pressed="false"
  aria-label={t.sound.ariaOff}
  title={t.sound.titleOff}
  data-aria-off={t.sound.ariaOff}
  data-aria-on={t.sound.ariaOn}
  data-title-off={t.sound.titleOff}
  data-title-on={t.sound.titleOn}
>
  <svg class="snd-icon" viewBox="0 0 16 16" aria-hidden="true">
    <path class="ic-speaker" d="M2 6v4h2.8L8 12.7V3.3L4.8 6H2Z" />
    <path class="ic-wave" d="M10.2 5.1a3.3 3.3 0 0 1 0 5.8" />
    <path class="ic-wave" d="M12 3.2a6 6 0 0 1 0 9.6" />
    <path class="ic-mute" d="M3.4 3.4l9.2 9.2" />
  </svg>
  <span class="snd-label">{t.sound.label} <strong class="snd-state">off</strong></span>
</button>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('sound-toggle') as HTMLButtonElement | null;
    if (!btn) return;

    const KEY = 'souf:sfx';
    const INTERACTIVE =
      'a, button, [role="button"], summary, select, label, input[type="submit"], input[type="checkbox"], input[type="radio"]';

    let enabled = false;
    try {
      const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
      enabled = !reduce && localStorage.getItem(KEY) === '1';
    } catch {
      enabled = false;
    }

    let ctx: AudioContext | null = null;
    let master: GainNode | null = null;
    let lastPlay = 0;

    const stateEl = btn.querySelector<HTMLElement>('.snd-state');

    const setUi = () => {
      btn.setAttribute('aria-pressed', String(enabled));
      btn.setAttribute('aria-label', enabled ? (btn.dataset.ariaOn ?? '') : (btn.dataset.ariaOff ?? ''));
      btn.title = enabled ? (btn.dataset.titleOn ?? '') : (btn.dataset.titleOff ?? '');
      if (stateEl) stateEl.textContent = enabled ? 'on' : 'off';
    };

    function ensureCtx() {
      if (ctx) return;
      const AC =
        window.AudioContext ||
        (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!AC) return;
      ctx = new AC();
      master = ctx.createGain();
      master.gain.value = 0.18;
      master.connect(ctx.destination);
    }

    function play() {
      const now = performance.now();
      if (now - lastPlay < 45) return;
      lastPlay = now;

      ensureCtx();
      if (!ctx || !master) return;
      if (ctx.state === 'suspended') void ctx.resume();

      const sr = ctx.sampleRate;
      const len = Math.round(sr * 0.025);
      const buf = ctx.createBuffer(1, len, sr);
      const data = buf.getChannelData(0);

      for (let i = 0; i < len; i++) {
        const t = i / sr;
        const env = Math.exp(-t * 280);
        data[i] = (Math.random() * 2 - 1) * env;
      }
      data[0] = 0.6;

      const src = ctx.createBufferSource();
      src.buffer = buf;
      src.connect(master);
      src.start();
    }

    btn.addEventListener('click', () => {
      enabled = !enabled;
      try {
        localStorage.setItem(KEY, enabled ? '1' : '0');
      } catch {
        /* storage unavailable — keep session state */
      }
      setUi();
      if (enabled) play();
    });

    // Capture phase: fires before any component-level stopPropagation, so
    // clicks on stack cards, project cards, injected modal links, etc. all hit.
    document.addEventListener(
      'click',
      (e) => {
        if (!enabled) return;
        const target = e.target as HTMLElement | null;
        if (!target) return;
        if (!target.closest(INTERACTIVE)) return;
        if (target.closest('#sound-toggle')) return;
        play();
      },
      true
    );

    setUi();
  });
</script>

<style>
  .snd-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.3rem 0.55rem;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .snd-toggle:hover {
    color: var(--text);
    border-color: var(--text-dim);
    background: rgba(23, 29, 38, 0.6);
  }

  .snd-toggle[aria-pressed='true'] {
    color: var(--accent-2);
    border-color: var(--accent-2);
    background: rgba(94, 234, 212, 0.06);
  }

  .snd-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .snd-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .ic-speaker,
  .ic-wave,
  .ic-mute {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ic-speaker {
    fill: currentColor;
    stroke: none;
  }

  .ic-mute {
    display: block;
  }

  .ic-wave {
    display: none;
  }

  .snd-toggle[aria-pressed='true'] .ic-mute {
    display: none;
  }

  .snd-toggle[aria-pressed='true'] .ic-wave {
    display: block;
  }

  .snd-state {
    font-weight: 700;
  }
</style>