---
// LabGrid.astro: projects zone, iterates over projects.ts data
import { projects, projectSlug } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import ProjectDetail from './ProjectDetail.astro';
import type { Dictionary } from '../i18n/translations/en';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;

const projectDescMap: Record<string, string> = {
  'ACOMED Mobile': t.projects.acomedMobile.description,
  CVBuilder: t.projects.cvBuilder.description,
  'Homelab-as-Code': t.projects.homelab.description,
  'rpg-combat-cpp': t.projects.rpg.description,
};
---

<section id="lab" class="lab-section zone">
  <div class="wrap">
    <h2 class="section-label">{t.lab.label}</h2>
    <div class="lab-grid">
      {projects.map((project) => (
        <ProjectCard
          id={projectSlug(project.name)}
          name={project.name}
          tagline={project.tagline}
          description={projectDescMap[project.name] ?? project.description}
          sections={project.sections ?? []}
          stack={project.stack}
          status={project.status}
          url={project.url}
          featured={project.featured ?? false}
          expandHint={t.lab.expandHint}
        />
      ))}
    </div>
  </div>
</section>

<ProjectDetail
  t={t}
  name=""
  description=""
  sections={[]}
  stack={[]}
  status=""
  url={null}
/>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('project-detail') as HTMLElement;
    if (!overlay) return;

    const backdrop = overlay.querySelector('.detail-backdrop') as HTMLElement;
    const closeBtn = document.getElementById('detail-close') as HTMLElement;
    const nameEl = document.getElementById('detail-name') as HTMLElement;
    const descEl = document.getElementById('detail-desc') as HTMLElement;
    const sectionsEl = document.getElementById('detail-sections') as HTMLElement;
    const stackEl = document.getElementById('detail-stack') as HTMLElement;
    const pillEl = document.getElementById('detail-pill') as HTMLElement;
    const pillText = document.getElementById('detail-pill-text') as HTMLElement;
    const linkEl = document.getElementById('detail-link') as HTMLElement;
    const titleEl = document.getElementById('detail-title') as HTMLElement;

    const statusColor: Record<string, string> = {
      'PUBLIC': 'var(--accent-2)',
      'ACTIVE': 'var(--accent)',
      'STABLE': 'var(--accent-2)',
      'IN PROGRESS': 'var(--warn)',
      'PRIVATE': 'var(--text-dim)',
    };

    let lastFocused: HTMLElement | null = null;

    function populate(card: HTMLElement) {
      const name = card.dataset.name ?? '';
      const desc = card.dataset.description ?? '';
      const stack: string[] = JSON.parse(card.dataset.stack ?? '[]');
      const status = card.dataset.status ?? '';
      const url = card.dataset.url ?? '';
      let sections: { heading: string; items: string[] }[] = [];
      try {
        sections = JSON.parse(card.dataset.sections ?? '[]');
      } catch {
        sections = [];
      }

      nameEl.textContent = name;
      descEl.textContent = desc;
      titleEl.textContent = `${name.toLowerCase().replace(/\s+/g, '-')}`;

      pillEl.hidden = false;
      pillText.textContent = status;
      pillEl.style.setProperty('--pill-color', statusColor[status] ?? 'var(--text-dim)');

      sectionsEl.innerHTML = sections
        .map(
          (s) => `
            <div class="detail-sec">
              <h4 class="detail-sec-head">// ${s.heading}</h4>
              <ul class="detail-sec-list">
                ${s.items.map((i) => `<li>${i}</li>`).join('')}
              </ul>
            </div>`
        )
        .join('');

      stackEl.innerHTML = stack
        .map((t) => `<span class="tag">${t}</span>`)
        .join('');

      if (url) {
        const label = url.includes('github.com') ? 'GitHub →' : 'Link →';
        linkEl.innerHTML = `<a href="${url}" target="_blank" rel="noopener noreferrer">${label}</a>`;
      } else {
        const noLink = overlay.dataset.noLink ?? 'no public link';
        linkEl.innerHTML = `<span class="no-link">${noLink}</span>`;
      }
    }

    function open(card: HTMLElement) {
      lastFocused = card;
      populate(card);
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
      lastFocused = null;
    }

    document.querySelectorAll<HTMLElement>('.card[data-name]').forEach((card) => {
      card.addEventListener('click', () => open(card));
      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(card);
        }
      });
    });

    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);

    overlay.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key === 'Tab') {
        const focusable = overlay.querySelectorAll<HTMLElement>(
          'button, [href], [tabindex]:not([tabindex="-1"])'
        );
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  });
</script>

<style>
  .lab-section {
    padding-block: clamp(4.5rem, 10vh, 7rem);
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 520px) {
    .lab-grid {
      grid-template-columns: 1fr;
    }
  }
</style>