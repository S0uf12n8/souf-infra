---
// StackGrid.astro — skills/tools inventory as a columnar status table
const rows = [
  { tool: 'C++',                  category: 'Languages',      status: 'STABLE' },
  { tool: 'Python',               category: 'Languages',      status: 'STABLE' },
  { tool: 'SQL',                  category: 'Languages',      status: 'RUNNING' },
  { tool: 'JavaScript/TypeScript', category: 'Languages',     status: 'RUNNING' },
  { tool: 'Docker',               category: 'Infra & DevOps', status: 'RUNNING' },
  { tool: 'Docker Compose',       category: 'Infra & DevOps', status: 'RUNNING' },
  { tool: 'k3s',                  category: 'Infra & DevOps', status: 'LEARNING' },
  { tool: 'GitHub Actions',       category: 'Infra & DevOps', status: 'RUNNING' },
  { tool: 'Prometheus',           category: 'Infra & DevOps', status: 'LEARNING' },
  { tool: 'Grafana',              category: 'Infra & DevOps', status: 'LEARNING' },
  { tool: 'Linux administration', category: 'Systems',        status: 'RUNNING' },
  { tool: 'Networking',           category: 'Systems',        status: 'RUNNING' },
  { tool: 'Kubernetes (depth)',   category: 'Learning',       status: 'LEARNING' },
  { tool: 'Terraform',            category: 'Learning',       status: 'LEARNING' },
  { tool: 'CI/CD hardening',      category: 'Learning',       status: 'LEARNING' },
];

const statusClass: Record<string, string> = {
  RUNNING: 'status-running',
  LEARNING: 'status-learning',
  STABLE: 'status-stable',
};
---

<section id="stack" class="stack-section">
  <h2 class="section-label">// STACK — INVENTORY</h2>
  <div class="table-wrapper">
    <table class="stack-table">
      <thead>
        <tr>
          <th class="col-tool">TOOL</th>
          <th class="col-category">CATEGORY</th>
          <th class="col-status">STATUS</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td class="col-tool">{row.tool}</td>
            <td class="col-category">{row.category}</td>
            <td class={`col-status ${statusClass[row.status]}`}>{row.status}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .stack-section {
    padding: 6rem 2rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .table-wrapper {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .stack-table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    table-layout: fixed;
  }

  .stack-table .col-tool    { width: 45%; }
  .stack-table .col-category { width: 35%; }
  .stack-table .col-status   { width: 20%; }

  thead {
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  th {
    text-align: left;
    font-weight: 500;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    padding: 0.65rem 1rem;
  }

  td {
    padding: 0.55rem 1rem;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  tr:last-child td {
    border-bottom: none;
  }

  tr:hover td {
    background: var(--surface-2);
  }

  .col-category {
    color: var(--text-dim);
  }

  .col-status {
    text-align: right;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .status-running {
    color: var(--accent);
  }

  .status-learning {
    color: var(--warn);
  }

  .status-stable {
    color: var(--accent-2);
  }

  @media (max-width: 520px) {
    .stack-table {
      min-width: 0;
    }

    .stack-table .col-category,
    th.col-category {
      display: none;
    }

    .stack-table .col-tool    { width: 65%; }
    .stack-table .col-status  { width: 35%; }
  }
</style>
