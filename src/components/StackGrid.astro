---
// StackGrid.astro: marquee row of stack cards; local brand SVGs; click reveals how each tool maps into Lab
import { projects, projectSlug, stackTools } from '../data/projects';

const projectBySlug = new Map<string, { name: string; href: string }>();
for (const p of projects) {
  projectBySlug.set(projectSlug(p.name), { name: p.name, href: `#${projectSlug(p.name)}` });
}

interface Card {
  slug: string;
  tool: string;
  icon: string;
  status: string;
  brief: string;
  project: { name: string; href: string } | null;
}

const cards: Card[] = stackTools.map((t) => ({
  slug: t.tool.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
  tool: t.tool,
  icon: t.icon,
  status: t.status,
  brief: t.brief,
  project: projectBySlug.get(t.project) ?? null,
}));

const statusClass: Record<string, string> = {
  RUNNING: 'badge-running',
  LEARNING: 'badge-learning',
  STABLE: 'badge-stable',
};

const groups = [
  { suffix: '', ariaHidden: false },
  { suffix: 'b', ariaHidden: true },
];
---

<section id="stack" class="stack-section zone">
  <div class="wrap">
    <h2 class="section-label">// STACK / INVENTORY</h2>
    <div class="marquee">
      <div class="marquee-track">
        {groups.map((g) => (
          <div class="marquee-group" aria-hidden={g.ariaHidden ? 'true' : undefined}>
            {cards.map((card, i) => {
              const revealId = `reveal-${card.slug}${g.suffix}`;
              return (
                <div
                  class="stack-card"
                  data-name={card.tool}
                  style={`--enter-delay: ${i * 45}ms`}
                >
                  <button
                    type="button"
                    class="card-hit"
                    aria-expanded="false"
                    aria-controls={revealId}
                    tabindex={g.ariaHidden ? -1 : undefined}
                  >
                    <div class="card-line">
                      <span class="stack-icon">
                        <img src={`/icons/${card.icon}.svg`} alt="" width="32" height="32" loading="lazy" />
                      </span>
                      <span class="reveal-cue" aria-hidden="true">▾</span>
                    </div>
                    <span class="card-name">{card.tool}</span>
                    <span class:list={['status-badge', statusClass[card.status]]}>{card.status}</span>
                  </button>

                  <div class="card-reveal" id={revealId}>
                    <span class="reveal-kicker">&gt; how it's used</span>
                    <p class="reveal-copy">{card.brief}</p>
                    {card.project && (
                      <a class="reveal-link" href={card.project.href}>{card.project.name} →</a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ))}
      </div>
    </div>
    <p class="section-note">click a tool card for how it maps into a Lab project · hover to pause, drag to browse</p>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector<HTMLElement>('.stack-section');

    if (section && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add('in');
              io.disconnect();
            }
          });
        },
        { threshold: 0.15 }
      );
      io.observe(section);
    }

    const cards = Array.from(document.querySelectorAll<HTMLElement>('.stack-card'));

    function closeAll() {
      cards.forEach((card) => {
        card.classList.remove('open');
        card.querySelector<HTMLElement>('.card-hit')?.setAttribute('aria-expanded', 'false');
      });
    }

    cards.forEach((card) => {
      card.querySelector<HTMLElement>('.card-hit')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = !card.classList.contains('open');
        closeAll();
        if (willOpen) {
          card.classList.add('open');
          card.querySelector<HTMLElement>('.card-hit')?.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.addEventListener('click', closeAll);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
  });
</script>

<style>
  .stack-section {
    padding-block: clamp(4rem, 8vh, 6rem);
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.75rem;
  }

  .marquee {
    --marquee-dur: 58s;
    position: relative;
    overflow: hidden;
    padding-bottom: 8.5rem;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll var(--marquee-dur) linear infinite;
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    gap: 1.5rem;
    padding-right: 1.5rem;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .stack-card {
    position: relative;
    flex: 0 0 224px;
    width: 224px;
    min-height: 150px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.2rem 1.15rem;
    transition: transform 0.22s ease, border-color 0.2s ease, background 0.2s ease;
    z-index: 1;
  }

  .stack-section.in .stack-card {
    animation: card-enter 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) backwards;
    animation-delay: var(--enter-delay, 0ms);
  }

  @keyframes card-enter {
    from { opacity: 0; transform: translateX(-36px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .stack-card:hover {
    transform: translateY(-4px);
    background: var(--surface-2);
    border-color: var(--accent-2);
    z-index: 5;
  }

  .stack-card.open {
    border-color: var(--accent);
    background: var(--surface-2);
    z-index: 20;
  }

  .card-hit {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    text-align: left;
  }

  .card-line {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .stack-icon {
    display: inline-flex;
    filter: drop-shadow(0 0 6px rgba(0, 0, 0, 0.4));
    transition: transform 0.2s ease;
  }

  .stack-card:hover .stack-icon {
    transform: translateY(-2px);
  }

  .reveal-cue {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-dim);
    line-height: 1;
    opacity: 0.55;
    transition: transform 0.22s ease, color 0.2s ease;
  }

  .stack-card:hover .reveal-cue {
    color: var(--accent);
  }

  .stack-card.open .reveal-cue {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .card-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.35;
  }

  .status-badge {
    align-self: flex-start;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    color: var(--text-dim);
  }

  .badge-running { color: var(--accent); }
  .badge-learning { color: var(--warn); }
  .badge-stable { color: var(--accent-2); }

  .card-reveal {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    width: min(340px, calc(100vw - 2rem));
    transform: translateX(-50%) translateY(-4px);
    background: var(--surface-2);
    border: 1px solid var(--accent-2);
    border-radius: 6px;
    padding: 0.65rem 0.8rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    z-index: 30;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }

  .stack-card.open .card-reveal {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .reveal-kicker {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.56rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-2);
    opacity: 0.75;
    margin-bottom: 0.35rem;
  }

  .reveal-copy {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text);
    margin-bottom: 0.45rem;
  }

  .reveal-link {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    color: var(--accent);
    line-height: 1.4;
  }

  .reveal-link:hover {
    text-decoration: underline;
  }

  .section-note {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    color: var(--text-dim);
    letter-spacing: 0.03em;
    text-align: center;
    margin-top: 0.75rem;
  }

  /* Touch/coarse-pointer devices can't hover to pause and can't swipe an
     overflow-hidden box, so the marquee drops to a plain scrollable strip. */
  @media (hover: none) and (pointer: coarse) {
    .marquee {
      overflow-x: auto;
      padding-bottom: 8.5rem;
      mask-image: none;
      -webkit-mask-image: none;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .marquee::-webkit-scrollbar {
      display: none;
    }

    .marquee-track {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      padding-bottom: 8.5rem;
      mask-image: none;
    }

    .marquee-track,
    .stack-section.in .stack-card {
      animation: none;
    }

    .stack-card,
    .stack-card .reveal-cue,
    .card-reveal {
      transition: none;
    }
  }
</style>