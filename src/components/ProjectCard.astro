---
// ProjectCard.astro — single project card (standard or featured/full-width)
interface Props {
  id?: string;
  name: string;
  tagline?: string;
  description: string;
  sections?: { heading: string; items: string[] }[];
  stack: string[];
  status: string;
  url: string | null;
  featured?: boolean;
}

const { id, name, tagline, description, sections = [], stack, status, url, featured = false } = Astro.props;

const statusColor: Record<string, string> = {
  'PUBLIC': 'var(--accent-2)',
  'ACTIVE': 'var(--accent)',
  'STABLE': 'var(--accent-2)',
  'IN PROGRESS': 'var(--warn)',
  'PRIVATE': 'var(--text-dim)',
};

const pillColor = statusColor[status] ?? 'var(--text-dim)';
---

<div
  id={id}
  class:list={['card', { featured }]}
  role="button"
  tabindex="0"
  data-name={name}
  data-description={description}
  data-sections={JSON.stringify(sections)}
  data-stack={JSON.stringify(stack)}
  data-status={status}
  data-url={url ?? ''}
>
  <div class="card-top">
    <h3 class="card-name">{name}</h3>
    <span class="status-pill" style={`--pill-color: ${pillColor}`}>
      <span class="pill-dot"></span>
      {status}
    </span>
  </div>

  {featured ? (
    <p class="card-desc card-desc-full">{description}</p>
  ) : (
    <p class="card-desc">{tagline || description}</p>
  )}

  {featured && sections.length > 0 && (
    <div class="card-sections">
      {sections.map((sec) => (
        <div class="card-sec">
          <h4 class="card-sec-head">{sec.heading}</h4>
          <ul class="card-sec-list">
            {sec.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}

  <div class="card-bottom">
    <div class="stack-tags">
      {stack.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
    <span class="card-expand-hint">details →</span>
  </div>
</div>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s, background 0.2s;
  }

  .card:hover {
    border-color: var(--accent-2);
    background: var(--surface-2);
  }

  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .card.featured {
    grid-column: 1 / -1;
    padding: 1.75rem 2rem;
    gap: 1rem;
    border-color: var(--accent-2);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .card-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .card.featured .card-name {
    font-size: 1.3rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--pill-color);
    border: 1px solid var(--pill-color);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pill-color);
  }

  .card-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-dim);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-desc-full {
    display: block;
    -webkit-line-clamp: none;
    -webkit-box-orient: unset;
    overflow: visible;
    font-size: 0.95rem;
    max-width: 70ch;
  }

  .card-sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .card-sec-head {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-2);
    margin-bottom: 0.5rem;
  }

  .card-sec-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .card-sec-list li {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .card-sec-list li::before {
    content: '▸ ';
    color: var(--accent-2);
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    background: var(--surface-2);
    color: var(--text-dim);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .card-expand-hint {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent-2);
    opacity: 0;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .card:hover .card-expand-hint {
    opacity: 1;
  }
</style>