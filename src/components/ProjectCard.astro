---
// ProjectCard.astro — single project card
interface Props {
  name: string;
  description: string;
  stack: string[];
  status: string;
  url: string | null;
}

const { name, description, stack, status, url } = Astro.props;

const statusColor: Record<string, string> = {
  'ACTIVE': 'var(--accent)',
  'STABLE': 'var(--accent-2)',
  'IN PROGRESS': 'var(--warn)',
  'PRIVATE': 'var(--text-dim)',
};

const pillColor = statusColor[status] ?? 'var(--text-dim)';
const isPublic = status === 'PUBLIC';
---

<div
  class="card"
  role="button"
  tabindex="0"
  data-name={name}
  data-description={description}
  data-stack={JSON.stringify(stack)}
  data-status={status}
  data-url={url ?? ''}
>
  <div class="card-top">
    <h3 class="card-name">{name}</h3>
    {!isPublic && (
      <span class="status-pill" style={`--pill-color: ${pillColor}`}>
        <span class="pill-dot"></span>
        {status}
      </span>
    )}
  </div>
  <p class="card-desc">{description}</p>
  <div class="card-bottom">
    <div class="stack-tags">
      {stack.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
    {url ? (
      <span class="card-expand-hint">details →</span>
    ) : (
      <span class="card-expand-hint">details →</span>
    )}
  </div>
</div>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s, background 0.2s;
    cursor: pointer;
  }

  .card:hover {
    border-color: var(--accent-2);
    background: var(--surface-2);
  }

  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .card-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--pill-color);
    border: 1px solid var(--pill-color);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pill-color);
  }

  .card-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-dim);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    background: var(--surface-2);
    color: var(--text-dim);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .card-expand-hint {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent-2);
    opacity: 0;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .card:hover .card-expand-hint {
    opacity: 1;
  }
</style>
